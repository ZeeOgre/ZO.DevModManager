<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>espesmswap</AssemblyName>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <DebugType>None</DebugType>
    <DistributionDir>$(MSBuildProjectDirectory)\dist</DistributionDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DMM.AssetManagers\DMM.AssetManagers.csproj" />
  </ItemGroup>

  <!-- A Release build must leave users with the requested runnable artifact, not
       merely the managed DLL that MSBuild reports as the primary build output. -->
  <Target Name="PublishStandaloneExecutable"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(Configuration)' == 'Release' AND '$(_IsPublishing)' != 'true'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c Release -r win-x64 --self-contained true --no-restore -p:PublishSingleFile=true -p:PublishTrimmed=true -p:DebugType=None -o &quot;$(DistributionDir)&quot;" />
    <Message Text="Produced runnable self-contained executable: $(DistributionDir)\espesmswap.exe" Importance="high" />
  </Target>
</Project>
